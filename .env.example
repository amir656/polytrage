# Telegram — get a token from @BotFather, then /start your bot to get your chat ID
TELEGRAM_BOT_TOKEN=your_bot_token_here
TELEGRAM_CHAT_ID=your_chat_id_here

# Kalshi (optional) — enables cross-venue arbitrage detection (Polymarket vs Kalshi)
# Sign up at https://kalshi.com and use your login credentials
KALSHI_EMAIL=your_kalshi_email_here
KALSHI_PASSWORD=your_kalshi_password_here

# Poller settings
MIN_PROFIT_MARGIN=3.0         # minimum % profit to flag as an opportunity
SCAN_INTERVAL_SECONDS=60      # how often to scan (seconds)
